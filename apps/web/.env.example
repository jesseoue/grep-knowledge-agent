# =============================================================================
# Grep Knowledge Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# On Railway, set these as project variables (or per-service variables).
# See docs/ENVIRONMENT.md for detailed instructions on finding each value.
#
# For local dev with docker-compose:
#   docker compose up -d postgres redis sandbox
# Then uncomment the docker-compose defaults below.

# --- Database (Railway Postgres) -------------------------------------------
# Provided automatically by Railway Postgres plugin.
# For local dev with docker-compose:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/railway
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# --- Redis (Railway Redis) --------------------------------------------------
# Provided automatically by Railway Redis plugin.
# For local dev with docker-compose:
#   REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://default:pass@host:6379

# --- Sandbox service ----------------------------------------------------------
# Private hostname of the sandbox service on Railway's internal network.
# For local dev with docker-compose:
#   SANDBOX_URL=http://localhost:3200
# SANDBOX_URL=http://sandbox.railway.internal:3200

# --- Authentication ----------------------------------------------------------
# Session signing secret. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# GitHub OAuth app — OPTIONAL. Email/password works without it.
# Only set these to enable "Continue with GitHub" on the login page.
# See docs/ENVIRONMENT.md → "Setting up GitHub OAuth"
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- AI Provider (at least one required) -------------------------------------
# Bring your own key. At least ONE of these must be set.
#
# OpenRouter (RECOMMENDED) → https://openrouter.ai/settings/keys
#   One key unlocks every model (Anthropic, OpenAI, Google, DeepSeek, Qwen, ...)
#   via a single endpoint. Set ONLY this key and the app just works.
#   Enables: gpt-5.4-mini, gpt-5.4, gpt-5.4-pro
# OPENROUTER_API_KEY=sk-or-...
#
# OpenAI → https://platform.openai.com/api-keys
#   Enables: gpt-4o, gpt-4o-mini
# OPENAI_API_KEY=sk-...
#
# Anthropic → https://console.anthropic.com/settings/keys
#   Enables: claude-haiku-4-5, claude-sonnet-4-6, claude-opus-4-8
# ANTHROPIC_API_KEY=sk-ant-...
#
# Google Gemini → https://aistudio.google.com/apikey
#   Enables: gemini-2.5-flash
# GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# --- Snapshot repository (optional) -----------------------------------------
# Default owner/repo to sync on first run (e.g. vercel-labs/knowledge-agent-template)
# SNAPSHOT_REPO=
# SNAPSHOT_BRANCH=main

# --- Public URL (optional) ---------------------------------------------------
# Your public app URL — used for auth trusted origins.
# PUBLIC_SITE_URL=https://your-app.up.railway.app

# --- Credit / usage quota (optional) ----------------------------------------
# Max tokens a user may consume (all-time). 0 = unlimited.
# Set to cap free usage and bill against credits.
# MAX_TOKENS_PER_USER=1000000
