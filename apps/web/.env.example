# =============================================================================
# Grep Knowledge Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# On Railway, set these as project variables (or per-service variables).
# See docs/ENVIRONMENT.md for detailed instructions on finding each value.

# --- Database (Railway Postgres) -------------------------------------------
# Provided automatically by Railway Postgres plugin.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# --- Redis (Railway Redis) --------------------------------------------------
# Provided automatically by Railway Redis plugin.
# REDIS_URL=redis://default:pass@host:6379

# --- Authentication ----------------------------------------------------------
# Session signing secret. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# GitHub OAuth app — see docs/ENVIRONMENT.md → "Setting up GitHub OAuth"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AI Provider (at least one required) -------------------------------------
# Bring your own key. At least ONE of these must be set.
#
# OpenAI → https://platform.openai.com/api-keys
#   Enables: gpt-4o, gpt-4o-mini
# OPENAI_API_KEY=sk-...
#
# Anthropic → https://console.anthropic.com/settings/keys
#   Enables: claude-sonnet-4, claude-opus-4, claude-haiku-4
# ANTHROPIC_API_KEY=sk-ant-...
#
# Google Gemini → https://aistudio.google.com/apikey
#   Enables: gemini-2.0-flash, gemini-2.5-flash
# GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# --- Snapshot repository (optional) -----------------------------------------
# Default owner/repo to sync on first run (e.g. vercel-labs/knowledge-agent-template)
# SNAPSHOT_REPO=
# SNAPSHOT_BRANCH=main

# --- Sandbox service ----------------------------------------------------------
# Private hostname of the sandbox service on Railway's internal network.
# SANDBOX_URL=http://sandbox.railway.internal:3200

# --- Public URL (optional) ---------------------------------------------------
# Your public app URL — used for auth trusted origins.
# PUBLIC_SITE_URL=https://your-app.up.railway.app
